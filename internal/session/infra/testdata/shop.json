{
  "$schema": "./weaver.schema.json",
  "root": "~/dev/shop",
  "repositories": {
    "back": "git@bitbucket.org:acme/shop-back.git",
    "front": "git@bitbucket.org:acme/shop-front.git"
  },
  "env": {
    "APP_ENV": "local"
  },
  "windows": [
    {
      "name": "shop",
      "panes": [
        {
          "name": "back",
          "dir": "back",
          "runtimes": {
            "php": "8.4"
          }
        },
        {
          "name": "front",
          "dir": "front",
          "split": {
            "direction": "right",
            "size": "30%"
          },
          "note": [
            "",
            "Usual commands:",
            "",
            "  npm i",
            "  npm run dev",
            ""
          ],
          "env": {
            "APP_ENV": "dev"
          },
          "runtimes": {
            "node": "20"
          }
        }
      ]
    }
  ]
}
