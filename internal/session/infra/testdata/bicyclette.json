{
  "$schema": "./weaver.schema.json",
  "root": "~/dev/bicyclette",
  "repositories": {
    ".": "https://github.com/medilies/bicyclette.git"
  },
  "windows": [
    {
      "name": "api",
      "panes": [
        {
          "name": "api shell",
          "dir": "api"
        },
        {
          "name": "task dev",
          "dir": "api",
          "split": {
            "direction": "right",
            "size": "40%"
          },
          "command": "task dev"
        },
        {
          "name": "psql",
          "split": {
            "direction": "below"
          },
          "command": "bicyclette psql"
        }
      ]
    },
    {
      "name": "app",
      "panes": [
        {
          "name": "app shell",
          "dir": "app"
        },
        {
          "name": "flutter run",
          "dir": "app",
          "split": {
            "direction": "right",
            "size": "40%"
          },
          "command": "bicyclette app"
        },
        {
          "name": "emulator",
          "split": {
            "direction": "below",
            "size": "30%"
          },
          "prefill": "bicyclette emulator"
        }
      ]
    },
    {
      "name": "repo"
    }
  ]
}
